{
  "name": "@parke.dev/pi-extensions",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo of pi coding agent extensions published as individual packages",
  "type": "module",
  "license": "MIT",
  "author": "Luke Parke",
  "homepage": "https://github.com/LukasParke/pi-extensions#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LukasParke/pi-extensions.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"packages/**/*.{ts,md,json}\" \"*.{json,md}\"",
    "format:check": "prettier --check \"packages/**/*.{ts,md,json}\" \"*.{json,md}\"",
    "check": "npm run typecheck && npm run format:check && npm test",
    "pack:check": "npm pack --dry-run --workspaces",
    "release:check": "npm run check && npm run pack:check"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.82.0",
    "@earendil-works/pi-coding-agent": "^0.82.0",
    "@earendil-works/pi-tui": "^0.82.0",
    "@types/node": "^24.12.0",
    "prettier": "^3.4.2",
    "typebox": "^1.1.38",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
