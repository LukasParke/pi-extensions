      "./extensions/dashboard.ts"
    ],
    "themes": [
      "./themes"
    ]
  },
  "dependencies": {
    "@parke.dev/pi-ext-config": "^0.1.0",
    "@parke.dev/pi-git": "^0.1.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
