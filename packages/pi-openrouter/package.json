{
  "name": "@parke.dev/pi-openrouter",
  "version": "0.2.0",
  "description": "OpenRouter model catalog sync for pi: generates models.json entries with per-model API surface routing (completions/responses/messages), benchmark-driven rules, and a surface benchmark harness",
  "type": "module",
  "license": "MIT",
  "author": "Luke Parke",
  "homepage": "https://github.com/LukasParke/pi-extensions/tree/main/packages/pi-openrouter#readme",
  "bugs": {
    "url": "https://github.com/LukasParke/pi-extensions/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LukasParke/pi-extensions.git",
    "directory": "packages/pi-openrouter"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "openrouter",
    "provider",
    "routing",
    "benchmark",
    "extension",
    "parke.dev"
  ],
  "files": [
    "src",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "scripts": {
    "benchmark": "bun run scripts/benchmark.ts"
  },
  "dependencies": {
    "@parke.dev/pi-ext-config": "^0.1.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "pi-openrouter": "./src/cli.ts"
  }
}
